# Copy to .env and replace both values before exposing the app beyond localhost.
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-a-long-random-secret
# Optional: enables RAG indexing and the AI career assistant. Resume text is sent to OpenAI when configured.
OPENAI_API_KEY=
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
